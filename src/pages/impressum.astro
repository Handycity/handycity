---
import LegalLayout from '../layouts/LegalLayout.astro';
import { loadContentSync } from '../lib/content-store.mjs';
import type { Content } from '../lib/content-types';

const content = loadContentSync() as Content;
const { impressum } = content;
---
<LegalLayout title={impressum.headline}>
  <h1 class="text-2xl md:text-3xl font-bold text-navy mb-8">{impressum.headline}</h1>
  <div class="text-slate-600 leading-relaxed whitespace-pre-line">
    {impressum.content}
  </div>
</LegalLayout>
